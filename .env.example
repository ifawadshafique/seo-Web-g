# Copy to .env for the app and CLI scripts. Never commit real secrets (ENV-6).

# local | staging | production
APP_ENV=local

DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/seo_web_dev
# Managed deployments: unpooled URL for migrations; runtime keeps DATABASE_URL.
DIRECT_URL=

SITE_URL=http://localhost:3000
SITE_TIMEZONE=Asia/Karachi

# AD-14: off | placeholder | live. Use placeholder only on protected staging.
ADS_MODE=off
# Required when ADS_MODE=live, e.g. pub-1234567890123456
ADSENSE_PUBLISHER_ID=

# ENV-2: "user:password" enables basic auth on non-production deployments
STAGING_BASIC_AUTH=

# Required for MFA encryption: generate with openssl rand -hex 32; retain securely.
AUTH_ENCRYPTION_KEY=
# Enable only behind a proxy that overwrites X-Forwarded-For (e.g. Vercel).
TRUST_PROXY=false

# Optional: works only with APP_ENV=local and next dev.
LOCAL_AUTH_SKIP_MFA=false

# Durable publication worker authentication. Generate a random value.
CRON_SECRET=
# Local: npm run worker. The free hosted prototype has no automatic schedule.
# SMTP is optional locally; messages stay in the admin inbox when absent.
SMTP_URL=
CONTACT_TO=
MAIL_FROM=
# Required outside local development for image uploads (AWS credentials via standard env).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MEDIA_STORAGE=s3
# Alternative for the free Vercel prototype: MEDIA_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phase 3: keep live ads disabled until approval and a certified CMP are configured.
COOKIEBOT_DOMAIN_GROUP_ID=
COOKIEBOT_TCF_ENABLED=false
GA4_MEASUREMENT_ID=
ADSENSE_APPROVED=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# report-only is the Phase 3 default. "off" is allowed only locally.
CSP_MODE=report-only
# After a real seven-day staging review, copy the reviewed JSON evidence here for production enforcement.
CSP_STAGING_EVIDENCE=

# Optional private credential for checks against Vercel platform protection.
VERCEL_AUTOMATION_BYPASS_SECRET=
