{
  "name": "seo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "user:create": "tsx scripts/create-user.ts",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "tsx scripts/phase1-integration.ts",
    "db:local:start": "/usr/lib/postgresql/18/bin/pg_ctl -D .local/postgres -l .local/postgres.log -o \"-p 5432 -h 127.0.0.1 -k /tmp\" start",
    "db:local:stop": "/usr/lib/postgresql/18/bin/pg_ctl -D .local/postgres stop",
    "worker": "tsx scripts/worker.ts",
    "test:phase2": "node scripts/check-phase2.mjs",
    "setup:publishing": "tsx scripts/setup-publishing.ts",
    "test:phase3": "node scripts/check-phase3.mjs",
    "test:performance": "CHECK_PERFORMANCE=true node scripts/check-phase3.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "prepare:staging": "node scripts/prepare-staging.mjs",
    "build:staging": "node --import tsx scripts/vercel-build.ts",
    "check:staging-env": "node --import tsx scripts/vercel-build.ts --check",
    "backup:create": "node --import tsx scripts/recovery.mjs backup",
    "backup:drill": "node --import tsx scripts/recovery.mjs restore-drill",
    "check:dependencies": "npm audit --audit-level=moderate --fetch-timeout=30000 --fetch-retries=1",
    "check:release": "node --import tsx scripts/release-readiness.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "htmlparser2": "^12.0.0",
    "i18n-iso-countries": "^7.14.0",
    "iron-session": "^9.1.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "chrome-launcher": "^1.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    },
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.9"
    }
  }
}
